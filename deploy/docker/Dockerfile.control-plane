FROM node:22-bookworm-slim AS base

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

ARG PNPM_VERSION=10.24.0
ARG NPM_REGISTRY=

RUN if [ -n "$NPM_REGISTRY" ]; then npm config set registry "$NPM_REGISTRY"; fi \
  && npm install -g "pnpm@${PNPM_VERSION}" \
  && if [ -n "$NPM_REGISTRY" ]; then pnpm config set registry "$NPM_REGISTRY"; fi

FROM base AS deps

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ openssh-client unzip postgresql-client && rm -rf /var/lib/apt/lists/*

COPY package.json pnpm-lock.yaml ./

RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
  pnpm install --frozen-lockfile --prefer-offline

FROM deps AS build

WORKDIR /app

COPY . .

ARG WORKER_INSTALLER_CHANNEL=preview
ARG WORKER_INSTALLER_PACKAGE_VERSION=
ARG VITE_GA_MEASUREMENT_ID=

# 拆成独立层：WORKER_INSTALLER_PACKAGE_VERSION 每次 preview 发布都变（含 sha），
# 若与 pnpm build 同层会导致构建层缓存永远失效；拆开后同源码 rerun 可命中 build 层。
RUN pnpm build

RUN if [ -n "$WORKER_INSTALLER_PACKAGE_VERSION" ]; then \
    pnpm build:worker:installer -- --channel "$WORKER_INSTALLER_CHANNEL" --package-version "$WORKER_INSTALLER_PACKAGE_VERSION"; \
  else \
    pnpm build:worker:installer -- --channel "$WORKER_INSTALLER_CHANNEL"; \
  fi

FROM deps AS worker-dev-deps

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl git unzip && rm -rf /var/lib/apt/lists/*

FROM minio/minio:latest AS minio

FROM minio/mc:latest AS minio-client

FROM node:22-bookworm-slim AS runtime

ARG INCLUDE_BUNDLED_POSTGRES=true
ARG WEMUX_CORE_SHA=unknown
ARG WEMUX_CLOUD_SHA=none

LABEL ai.wemux.core.revision=$WEMUX_CORE_SHA \
      ai.wemux.cloud.revision=$WEMUX_CLOUD_SHA

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=8989

WORKDIR /app

RUN apt-get update \
  && packages="gosu ca-certificates openssh-client unzip" \
  && if [ "$INCLUDE_BUNDLED_POSTGRES" = "true" ]; then packages="$packages postgresql postgresql-client"; fi \
  && apt-get install -y --no-install-recommends $packages \
  && rm -rf /var/lib/apt/lists/*

COPY --from=deps /app/node_modules ./node_modules
COPY --from=build /app/dist-server ./dist-server
COPY --from=build /app/apps/web/.output ./apps/web/.output
COPY --from=build /app/apps/web/src/content ./apps/web/src/content
COPY --from=minio /usr/bin/minio /usr/local/bin/minio
COPY --from=minio-client /usr/bin/mc /usr/local/bin/mc
COPY package.json ./
COPY deploy/docker/control-plane-entrypoint.sh /usr/local/bin/control-plane-entrypoint.sh

EXPOSE 8989
VOLUME ["/var/lib/vibemux/object-storage"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:' + (process.env.PORT || '8989') + '/api/health').then((response) => { const contentType = response.headers.get('content-type') || ''; process.exit(response.ok && contentType.includes('application/json') ? 0 : 1) }).catch(() => process.exit(1))"

ENTRYPOINT ["control-plane-entrypoint.sh"]
CMD ["node", "dist-server/apps/server/src/control-plane-entry.js"]
