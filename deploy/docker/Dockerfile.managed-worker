# syntax=docker/dockerfile:1.7
FROM node:22-bookworm-slim AS base

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

ARG PNPM_VERSION=10.24.0
ARG NPM_REGISTRY=

RUN if [ -n "$NPM_REGISTRY" ]; then npm config set registry "$NPM_REGISTRY"; fi \
  && npm install -g "pnpm@${PNPM_VERSION}" \
  && if [ -n "$NPM_REGISTRY" ]; then pnpm config set registry "$NPM_REGISTRY"; fi

FROM base AS deps

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ && rm -rf /var/lib/apt/lists/*

COPY package.json pnpm-lock.yaml ./

RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
  pnpm install --frozen-lockfile --prefer-offline

FROM deps AS build

WORKDIR /app

COPY . .

RUN pnpm build:worker:npm

FROM base AS runtime

ENV NODE_ENV=production
ENV VIBEMUX_WORKER_HOME=/var/lib/vibemux-worker
ENV VIBEMUX_WORKER_PORT=48100
ENV VIBEMUX_WORKER_INSTALL_PREFIX=/opt/vibemux-worker
ENV VIBEMUX_WORKER_RESTART_STRATEGY=docker
ENV VIBEMUX_WORKER_AUTO_UPDATE=1
ENV VIBEMUX_WORKER_RELEASE_CHANNEL=production
ENV PATH=/opt/vibemux-worker/bin:$PATH

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
  bash \
  ca-certificates \
  curl \
  git \
  gosu \
  openssh-client \
  python3 \
  ripgrep \
  && rm -rf /var/lib/apt/lists/*

# opencode 平台二进制已从 package.tgz 剔除（P0 包瘦身），镜像内显式安装以兑底 linux 云端 worker
RUN npm install -g @openai/codex @anthropic-ai/claude-code opencode-ai

RUN groupadd --system --gid 10001 vibemux \
  && useradd --system --uid 10001 --gid 10001 --home-dir /var/lib/vibemux-worker --shell /usr/sbin/nologin vibemux

COPY --from=build /app/dist-server/worker-installer/package.tgz /tmp/vibemux-worker-package.tgz

RUN mkdir -p /var/lib/vibemux-worker /opt/vibemux-worker \
  && npm install --no-fund --no-audit -g --prefix /opt/vibemux-worker /tmp/vibemux-worker-package.tgz \
  && rm -f /tmp/vibemux-worker-package.tgz \
  && chown -R 10001:10001 /var/lib/vibemux-worker /opt/vibemux-worker

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:' + (process.env.VIBEMUX_WORKER_PORT || '48100') + '/api/health').then((response) => process.exit(response.ok ? 0 : 1)).catch(() => process.exit(1))"

CMD ["vibemux-worker", "daemon"]
