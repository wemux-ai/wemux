# Local development defaults. Replace the secret placeholders before sharing a server.
NODE_ENV=development
HOST=0.0.0.0
PORT=8989
DATABASE_URL=postgres://vibemux:local-dev-password@127.0.0.1:5434/vibemux
WEMUX_RUNTIME_DIR=.vibemux/runtime
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9100
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=vibemux
OBJECT_STORAGE_ACCESS_KEY_ID=vibemux
OBJECT_STORAGE_SECRET_ACCESS_KEY=local-dev-secret
WEMUX_CLOUD_URL=http://127.0.0.1:8989
WEMUX_WORKER_CONSOLE_URL=http://127.0.0.1:48121
WEMUX_PUBLIC_BASE_URL=http://127.0.0.1:8989
APP_URL=http://127.0.0.1:8989
VITE_API_BASE_URL=http://127.0.0.1:8989
VITE_APP_BASE_URL=http://127.0.0.1:3000
TOKEN_SECRET=replace-with-local-token-secret
GIT_CREDENTIAL_KEY=replace-with-local-git-credential-key
BETTER_AUTH_SECRET=replace-with-local-better-auth-secret
TURNSTILE_COOKIE_SECRET=replace-with-local-turnstile-cookie-secret
BETTER_AUTH_URL=http://127.0.0.1:8989
BETTER_AUTH_TRUSTED_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:8989,http://localhost:3000,http://localhost:8989
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
