{
  "name": "wemux",
  "version": "0.3.130",
  "description": "wemux — an AI delivery platform where workers execute code tasks on real device nodes: self-hostable control plane, web console, and worker daemon (monorepo).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/wemux-ai/wemux.git"
  },
  "bugs": "https://github.com/wemux-ai/wemux/issues",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.24.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm dev:tui",
    "quickstart": "node scripts/quickstart.mjs",
    "dev:oss": "cross-env WEMUX_EXTENSION_DISABLED=1 pnpm dev",
    "dev:preview": "pnpm dev:tui:preview",
    "dev:client": "vite dev",
    "dev:client:docker": "vite dev",
    "dev:offline": "vite dev --mode offline",
    "dev:server": "cross-env NODE_ENV=development DOTENV_CONFIG_PATH=.env.development.local tsx watch apps/server/src/index.ts",
    "dev:server:docker": "cross-env NODE_ENV=development tsx watch apps/server/src/index.ts",
    "dev:worker": "pnpm build:worker:console && cross-env WEMUX_WORKER_HOME= WEMUX_WORKER_PORT_PROFILE=development WEMUX_WORKER_PORT=48121 WEMUX_CLOUD_URL=http://127.0.0.1:8989 NODE_ENV=development DOTENV_CONFIG_PATH=.env.development.local tsx apps/worker/src/index.ts daemon",
    "dev:worker:hybrid": "pnpm build:worker:console && cross-env WEMUX_WORKER_HOME= WEMUX_WORKER_PORT_PROFILE=development WEMUX_WORKER_PORT=48121 WEMUX_CLOUD_URL=http://127.0.0.1:18989 NODE_ENV=development DOTENV_CONFIG_PATH=.env.development.local tsx apps/worker/src/index.ts daemon",
    "dev:worker:preview": "pnpm build:worker:console && cross-env WEMUX_WORKER_HOME= WEMUX_WORKER_PORT_PROFILE=preview WEMUX_WORKER_PORT=48123 WEMUX_CLOUD_URL=https://wemux.xyz/ NODE_ENV=development DOTENV_CONFIG_PATH=.env.development.local tsx apps/worker/src/index.ts daemon",
    "dev:desktop": "pnpm --dir apps/desktop dev",
    "dev:native": "pnpm dev:desktop",
    "dev:mobile": "pnpm --dir apps/mobile start",
    "mobile:init": "pnpm --dir apps/mobile prebuild",
    "mobile:android": "pnpm --dir apps/mobile android",
    "mobile:ios": "pnpm --dir apps/mobile ios",
    "native:mobile:init": "pnpm mobile:init",
    "native:mobile:android": "pnpm mobile:android",
    "native:mobile:ios": "pnpm mobile:ios",
    "dev:infra:up": "docker compose -f deploy/docker/docker-compose.infra.yml up -d",
    "dev:infra:down": "docker compose -f deploy/docker/docker-compose.infra.yml down",
    "dev:infra:logs": "docker compose -f deploy/docker/docker-compose.infra.yml logs -f postgres rustfs",
    "dev:hybrid": "node scripts/run-hybrid-dev.mjs full",
    "dev:hybrid:stack": "node scripts/run-hybrid-dev.mjs stack",
    "dev:hybrid:up": "node scripts/run-hybrid-dev.mjs up",
    "dev:hybrid:down": "docker compose -f deploy/docker/docker-compose.dev-hybrid.yml down --remove-orphans",
    "dev:hybrid:logs": "docker compose -f deploy/docker/docker-compose.dev-hybrid.yml logs -f web server",
    "dev:docker": "node scripts/run-full-dev.mjs full",
    "dev:docker:stack": "node scripts/run-full-dev.mjs stack",
    "dev:docker:up": "node scripts/run-full-dev.mjs up",
    "dev:docker:down": "docker compose -f deploy/docker/docker-compose.dev-full.yml down --remove-orphans",
    "dev:docker:logs": "docker compose -f deploy/docker/docker-compose.dev-full.yml logs -f web server worker",
    "db:reset": "pnpm dev:infra:down && docker volume rm wemux_wemux-postgres-data && pnpm dev:infra:up",
    "db:reset:all": "pnpm dev:infra:down && docker volume rm wemux_wemux-postgres-data wemux_wemux-rustfs-data && pnpm dev:infra:up",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:migrate:agent-scope": "tsx scripts/migrate-agent-workspace-scope.ts",
    "dev:tui": "turbo run dev:server dev:client dev:worker --parallel --ui=tui --single-package",
    "dev:tui:preview": "turbo run dev:server dev:client dev:worker:preview --parallel --ui=tui --single-package",
    "build": "pnpm build:client && pnpm build:server",
    "build:client": "vite build",
    "build:native:web-static": "pnpm build:client && pnpm exec tsx scripts/export-native-web-static.mjs",
    "build:desktop": "pnpm --dir apps/desktop build",
    "build:meeting-runtime": "node scripts/build-meeting-runtime.mjs",
    "build:mobile": "pnpm --dir apps/mobile export",
    "build:native": "pnpm build:desktop",
    "desktop:release": "node scripts/desktop-release.mjs",
    "build:offline": "vite build --mode offline",
    "build:server": "node scripts/build-runtime.mjs",
    "build:worker:console": "node scripts/build-worker-console.mjs",
    "build:worker:runtime": "node scripts/build-worker-runtime.mjs",
    "build:worker:installer": "node scripts/build-worker-installer.mjs",
    "build:worker:preview-installer": "node scripts/build-worker-installer.mjs --channel preview",
    "build:worker:npm": "node scripts/build-worker-runtime.mjs --release && node scripts/build-worker-console.mjs --release && node scripts/package-worker-npm.mjs",
    "start:offline": "vite preview --mode offline --host 127.0.0.1 --port 4173",
    "start:server": "cross-env NODE_ENV=production node --env-file=.env.production.local dist-server/apps/server/src/control-plane-entry.js",
    "start:worker": "cross-env NODE_ENV=production node --env-file=.env.production.local dist-server/apps/worker/src/index.js daemon",
    "start:easytier:public-node": "node scripts/run-easytier-public-node.mjs",
    "worker:doctor": "tsx apps/worker/src/index.ts doctor",
    "worker:docker": "node scripts/run-worker-docker.mjs",
    "worker:docker:dev": "node scripts/run-worker-docker-dev.mjs",
    "worker:test:fresh-docker": "node scripts/test-worker-fresh-docker.mjs",
    "worker:test:live-llm-docker": "node scripts/test-worker-live-llm-docker.mjs",
    "worker:test:provider-injection": "pnpm exec tsx --test apps/worker/src/execution/opencode/client.test.ts apps/worker/src/execution/runtime-launch-smoke.test.ts apps/worker/src/execution/pi-session-config.test.ts",
    "worker:test:runtime-launch": "pnpm exec tsx --test apps/worker/src/execution/runtime-launch-smoke.test.ts",
    "worker:unpair": "cross-env NODE_ENV=development DOTENV_CONFIG_PATH=.env.development.local tsx apps/worker/src/index.ts unpair",
    "worker:open": "pnpm build:worker:console && tsx apps/worker/src/index.ts open",
    "worker:reset": "tsx apps/worker/src/index.ts reset",
    "open-core:install-hooks": "node scripts/open-core/install-hooks.mjs",
    "open-core:check": "node scripts/open-core/public-boundary.mjs --tree HEAD",
    "open-core:push": "node scripts/open-core/push-upstream.mjs --public",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "e2e:multi-node": "tsx scripts/multi-node-e2e.mjs",
    "seo:check": "pnpm exec tsx scripts/check-marketing-seo.ts",
    "seo:lint": "pnpm exec tsx scripts/lint-marketing-seo.ts",
    "db:baseline": "node scripts/db-baseline-drizzle.mjs",
    "db:generate:all": "pnpm db:generate"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.16.1",
    "@ai-sdk/deepseek": "^2.0.55",
    "@alibaba-group/opensandbox": "^0.1.7",
    "@asciidev/box-sdk": "0.0.19",
    "@base-ui/react": "^1.3.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/inter": "^5.3.0",
    "@hono/node-server": "^1.13.8",
    "@hono/node-ws": "^1.3.0",
    "@larksuiteoapi/node-sdk": "^1.71.1",
    "@mariozechner/pi-coding-agent": "0.70.6",
    "@modelcontextprotocol/sdk": "1.27.1",
    "@opencode-ai/sdk": "^1.17.3",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-router": "^1.103.0",
    "@tanstack/react-start": "^1.103.0",
    "@tanstack/react-store": "^0.9.2",
    "@tanstack/react-virtual": "^3.14.9",
    "@vitejs/plugin-react": "^6.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "ai": "^6.0.116",
    "aws4fetch": "^1.0.20",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.6.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.3.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.7.6",
    "i18next": "^26.0.3",
    "i18next-browser-languagedetector": "^8.2.1",
    "kysely": "^0.28.16",
    "liquid-glass-react": "^1.1.1",
    "lucide-react": "^0.511.0",
    "node-pty": "^1.1.0",
    "opencode-ai": "^1.17.3",
    "pg": "^8.20.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.2",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.7.2",
    "recharts": "^3.10.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.0.6",
    "simple-git": "^3.27.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "three": "^0.180.0",
    "tw-animate-css": "^1.4.0",
    "typegpu": "^0.12.3",
    "vaul": "^1.1.2",
    "vite": "^8.0.0",
    "web-push": "^3.6.7",
    "ws": "^8.18.3",
    "xterm": "^5.3.0",
    "yaml": "^2.9.0",
    "zbsearch": "^3.3.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.18.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.180.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.1",
    "nitro": "3.0.260311-beta",
    "postcss": "^8.4.49",
    "railway": "^3.11.0",
    "react-grep": "^0.3.3",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.3",
    "turbo": "^2.8.17",
    "typescript": "^5.6.3",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "node-pty",
      "opencode-ai"
    ]
  }
}
