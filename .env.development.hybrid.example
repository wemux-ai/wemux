# Hybrid development: Postgres and the web/server run in Docker; worker runs on the host.
HYBRID_WEB_PORT=15173
HYBRID_SERVER_PORT=18989
HYBRID_BIND_HOST=127.0.0.1
CHOKIDAR_USEPOLLING=true
CHOKIDAR_INTERVAL=300
WEMUX_WORKER_PORT=48121
TOKEN_SECRET=replace-with-local-token-secret
GIT_CREDENTIAL_KEY=replace-with-local-git-credential-key
BETTER_AUTH_SECRET=replace-with-local-better-auth-secret
TURNSTILE_COOKIE_SECRET=replace-with-local-turnstile-cookie-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Hybrid compose requires an S3-compatible store. These defaults target the infra RustFS service.
OBJECT_STORAGE_ENDPOINT=http://host.docker.internal:9100
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=vibemux
OBJECT_STORAGE_ACCESS_KEY_ID=vibemux
OBJECT_STORAGE_SECRET_ACCESS_KEY=local-dev-secret
