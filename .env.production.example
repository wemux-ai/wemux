# Wemux 生产部署环境配置（自托管）
# 用法: cp .env.production.example .env.production && 编辑强密码 → docker compose --env-file .env.production up -d

# ── Postgres ──
POSTGRES_USER=wemux
POSTGRES_PASSWORD=replace-with-strong-postgres-password

# ── 对象存储（默认内置 MinIO）──
OBJECT_STORAGE_ACCESS_KEY_ID=wemux
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-strong-minio-password
OBJECT_STORAGE_BUCKET=wemux
OBJECT_STORAGE_REGION=us-east-1
MINIO_CONSOLE_PORT=9001

# ── 控制面 ──
SERVER_PORT=8989
WEMUX_PUBLIC_BASE_URL=http://localhost:8989
BETTER_AUTH_SECRET=replace-with-random-secret-1
TOKEN_SECRET=replace-with-random-secret-2
SECRET_ENCRYPTION_KEY=replace-with-random-secret-3
# 生成方式: openssl rand -hex 32

# ── Cloudflare Turnstile（可选，建议开启防机器人）──
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── 邮件发送（可选；不配置则注册无需邮箱验证，直接成功）──
# 配置后：邮箱注册会发送验证邮件并要求验证；忘记密码可发重置邮件。
EMAIL_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
EMAIL_FROM=noreply@example.com

# ── Google 登录（可选；不配置则登录页 Google 按钮置灰）──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── GitHub App 集成（可选；不配置则设置页 GitHub App 连接返回 503）──
# 在 GitHub → Settings → Developer settings → GitHub Apps 创建 App，
# Callback URL 设为 https://<你的域名>/api/user/github-app-installations/callback，
# 建议勾选 "Request user authorization (OAuth) during installation"。
# 核心三件套（缺一则功能整体关闭）：
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# 私钥需单行化：把 .pem 文件换行替换为字面 \n（server 会自动还原）
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# OAuth（授权账号 / 协作仓库聚合）：
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_CALLBACK_URL=https://example.com/api/user/github-app-installations/callback
# GitHub Enterprise（可选，默认 github.com）：
# GITHUB_APP_API_BASE_URL=
# GITHUB_APP_WEB_BASE_URL=

# ── 版本 ──
WEMUX_VERSION=latest

# ── 匿名使用上报 ──
# 自托管默认开启（见 docs/TELEMETRY.md）；设为 1 可关闭
# WEMUX_USAGE_REPORTING_DISABLED=

# ── AI 运维健康检查（可选）──
# 配置后 /api/health/detailed 需要 x-health-token 头（或 ?token=）才能访问
WEMUX_HEALTH_TOKEN=

# ── 社区反馈收件箱（全可选；不配置则渠道相关功能返回 503/纯规则模式）──
# 反馈 promote 成 GitHub issue 需要：
# WEMUX_FEEDBACK_PROMOTION_GITHUB_TOKEN=github_pat_xxx
# WEMUX_FEEDBACK_INTERNAL_REPO=your-org/your-private-repo
# WEMUX_FEEDBACK_COMMUNITY_REPO=wemux-ai/wemux
#
# AI 规范化/回复起草与审查（OpenAI 兼容端点，可指向任意 provider；不配置则纯规则兕底）：
# WEMUX_FEEDBACK_NORMALIZATION_API_KEY=
# WEMUX_FEEDBACK_NORMALIZATION_MODEL=deepseek-chat
# WEMUX_FEEDBACK_NORMALIZATION_BASE_URL=https://api.deepseek.com/chat/completions
#
# 飞书机器人事件订阅回调（/api/channels/feishu/events，需在飞书开放平台配置事件订阅）：
# WEMUX_FEEDBACK_FEISHU_ENCRYPT_KEY=
#
# Discord interaction 回调（/api/channels/discord/interactions，需注册 /feedback 斜杠命令）：
# WEMUX_FEEDBACK_DISCORD_PUBLIC_KEY=
