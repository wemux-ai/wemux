# OpenConnector 官方连接器 runtime 环境（复制为 .env.connector 并填真实值）
CONNECTOR_PORT=13000
CONNECTOR_ORIGIN=http://localhost:13000
OOMOL_CONNECT_ENCRYPTION_KEY=change-me-32-bytes-random
OOMOL_CONNECT_ADMIN_TOKEN=change-me-admin-token
OOMOL_CONNECT_RUNTIME_TOKEN=change-me-runtime-token
OOMOL_CONNECT_EGRESS_TRUSTED_HOSTS=
OOMOL_CONNECT_ALLOW_PRIVATE_NETWORK=false
OOMOL_CONNECT_LOG_LEVEL=info
